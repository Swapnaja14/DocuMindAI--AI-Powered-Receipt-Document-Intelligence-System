# DocuMind AI Frontend Environment Configuration
# Base URL for API requests.
# - Relative '/api/v1' routes through Vite's local dev proxy to the backend (http://127.0.0.1:8000).
# - Full URL (e.g. http://localhost:8000/api/v1) can be used for direct cross-origin backend connection.
VITE_API_BASE_URL=/api/v1
