# ==============================================================================
# DocuMind AI - Production Environment Configuration (.env.production.example)
# Copy this file to '.env' (or '.env.production') on your deployment server:
#   cp .env.production.example .env
#
# IMPORTANT: Never commit your actual .env or production credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Host Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
# External HTTP and HTTPS ports exposed by the Nginx reverse proxy on the host machine
PORT=80
HTTPS_PORT=443

# ------------------------------------------------------------------------------
# 2. Authentication & Cryptography
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 256-bit secret key:
#   openssl rand -hex 32
JWT_SECRET_KEY=change_me_to_a_secure_random_256_bit_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 3. Google Gemini AI API Configuration
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_production_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# ------------------------------------------------------------------------------
# 4. Database & Datastore Configuration (Docker Compose Service Names)
# ------------------------------------------------------------------------------
# Defaults route through Docker internal bridge network to the 'mongodb' service
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DATABASE=documind

# Defaults route through Docker internal bridge network to the 'redis' service
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true
REDIS_CACHE_TTL_SECONDS=600

# ------------------------------------------------------------------------------
# 5. Celery Asynchronous Processing Queue
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ------------------------------------------------------------------------------
# 6. Storage & Tenant Quotas
# ------------------------------------------------------------------------------
UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_MB=10
MAX_USER_STORAGE_MB=50
MAX_USER_DOCUMENTS=100

# ------------------------------------------------------------------------------
# 7. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# When deployed behind the unified Nginx reverse proxy, API requests are same-origin.
# Add your custom production domain or IP here if accessing backend directly:
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80
