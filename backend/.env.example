# Environment & Runtime Mode
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (MongoDB)
# In production, use authenticated URI with TLS/SSL: mongodb://user:password@host:27017/documind?authSource=admin&tls=true
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=documind

# Authentication & Security
# In production, generate a secure random 256-bit key: openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Storage & User Quotas
UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_MB=10
MAX_USER_STORAGE_MB=50
MAX_USER_DOCUMENTS=100

# Redis Cache & Celery Task Queue
# In production, use redis://:password@host:6379/0 or rediss:// for TLS
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=600
REDIS_ENABLED=true
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# FAISS Vector Index
FAISS_INDEX_PATH=storage/faiss/index.faiss

# Google Gemini LLM API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite